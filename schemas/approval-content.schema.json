{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bot-Shield/poppy-extensions/blob/main/schemas/approval-content.schema.json",
  "title": "botshield.ai/approval version 1, conversation content",
  "description": "The content a Company message carries in extensions[\"botshield.ai/approval\"] (spec 3.3, 8.4). The same approval object is in an API's 403 body under `approval`, and in an MCP tool error's structuredContent.approval.",
  "type": "object",
  "required": ["approval"],
  "properties": {
    "approval": { "$ref": "#/$defs/approval" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,256}$" },
    "approval": {
      "type": "object",
      "required": ["approval_id", "state", "summary", "terms", "expires_at"],
      "properties": {
        "approval_id": { "$ref": "#/$defs/id" },
        "state": { "enum": ["requested", "approved", "declined", "expired"] },
        "summary": { "type": "string", "minLength": 1 },
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "value": { "type": "string", "minLength": 1, "maxLength": 80 }
            },
            "additionalProperties": false
          }
        },
        "expires_at": { "type": "string", "format": "date-time" },
        "retry_after": { "type": "integer", "minimum": 1 }
      },
      "if": { "properties": { "state": { "const": "requested" } } },
      "then": { "required": ["retry_after"] }
    }
  }
}
