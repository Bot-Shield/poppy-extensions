{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couchtour-poppy-demo",
  "account_id": "9e8a7774180038be08d52d95adbc82c5",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  // A demo Couch Tour for BotShield's Poppy extensions. Not Couch Tour's production service.
  // Served on a subdomain, so nothing that assistants discover is on couchtour.app itself.
  "routes": [{ "pattern": "poppy-demo.couchtour.app", "custom_domain": true, "zone_name": "couchtour.app" }],
  "workers_dev": false,
  "vars": {
    // BotShield's production sandbox (a development key): real servers and a real phone.
    "BOTSHIELD_API_URL": "https://api.botshield.ai",
    "DEMO_HOST": "poppy-demo.couchtour.app",
    "DEMO_AGENT_NAME": "couchtour",
    "DEMO_REFUND_ACTION": "refund",
    // The phone number change, live: its own Action key, so its approvals are recorded under it in the
    // Console, not under the refund. Place an Action with this key in the Console before going live.
    // (Ticket orders, live, use the package's Action key `assistant` and gates-api/assistants/*.)
    "DEMO_PHONE_ACTION": "phone",
    "DEMO_PRESENCE_GATE": "poppy-demo-redrocks",
    "DEMO_LINK_GATE": "poppy-demo-link-2"
  },
  // Secrets: BOTSHIELD_SECRET_KEY (the demo company's bs_ key), DEMO_ACCOUNT_REF (the linked demo account),
  // DEMO_LIVE_KEY, DEMO_ADMIN_TOKEN, and ANTHROPIC_API_KEY (the demo agent's model).
  // Logos and icons, served from this Worker (not hotlinked).
  "assets": { "directory": "./public" },
  // The demo agent and Couch Tour share this host, so they reach each other through this binding.
  "services": [{ "binding": "SELF", "service": "couchtour-poppy-demo" }],
  "durable_objects": { "bindings": [{ "name": "STATE", "class_name": "DemoState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoState"] }],
  "observability": { "enabled": true }
}
