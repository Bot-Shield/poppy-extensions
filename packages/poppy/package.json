{
  "name": "@botshield/poppy",
  "version": "0.3.0",
  "description": "BotShield for the Personal Agent Protocol (Poppy), company side, for Node.js: the account holder's signed approval, and the BotShield Signal API for agentic commerce, which answers Match at each order.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/Bot-Shield/poppy-extensions.git", "directory": "packages/poppy" },
  "homepage": "https://github.com/Bot-Shield/poppy-extensions/tree/main/packages/poppy#readme",
  "bugs": { "url": "https://github.com/Bot-Shield/poppy-extensions/issues" },
  "keywords": ["poppy", "personal-agent-protocol", "botshield", "agentic-commerce", "signal-api", "passkey", "approval", "agents", "mcp"],
  "engines": { "node": ">=20" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
